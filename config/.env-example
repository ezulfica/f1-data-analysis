# AWS — S3 landing zone
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
s3_bucket=your_bucket_name
aws_region=eu-west-3

# Google BigQuery — data warehouse
BQ_PROJECT=your_gcp_project_id
BQ_DATASET=your_dataset_name

# GCP Service Account — place the JSON file OUTSIDE the repo (e.g. ~/.gcp/)
# Never store this file inside the project directory
SERVICE_ACCOUNT_JSON_PATH=/home/<your-user>/.gcp/f1-dataanalysis-sa.json
