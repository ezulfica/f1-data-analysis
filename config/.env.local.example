# Local dev environment — points to LocalStack instead of real AWS
# Copy to config/.env.local to use with docker-compose.local.yml

# LocalStack fake credentials (do not change)
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test
s3_bucket=ezu-f1-data
aws_region=eu-west-3

# LocalStack endpoint — resolved via Docker network (do not change)
S3_ENDPOINT_URL=http://localstack:4566

# BigQuery not used in local — dbt uses DuckDB via DBT_TARGET=local
BQ_PROJECT=local
BQ_DATASET=f1_dev
