# Local dev environment — points to floci instead of real AWS
# Copy to config/.env.local to use with docker-compose.yml

# Fake credentials for floci (any non-empty value works)
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test
s3_bucket=ezu-f1-data
aws_region=eu-west-3

# floci endpoint — resolved via Docker network (do not change)
S3_ENDPOINT_URL=http://floci:4566

# BigQuery not used locally — dbt uses DuckDB via DBT_TARGET=local
BQ_PROJECT=local
BQ_DATASET=f1_dev
